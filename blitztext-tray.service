[Unit]
Description=Blitztext System-Tray
After=blitztext.service graphical-session.target
Wants=blitztext.service

[Service]
Type=simple
WorkingDirectory=PROJECT_DIR
ExecStart=VENV_PATH/blitztext-tray
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=PYTHONPATH=/usr/lib/python3.14/site-packages

[Install]
WantedBy=graphical-session.target
