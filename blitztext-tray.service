[Unit]
Description=Blitztext System-Tray
After=blitztext.service graphical-session.target
Wants=blitztext.service

[Service]
Type=simple
ExecStart=VENV_PATH/blitztext-tray
Restart=on-failure
RestartSec=5
# Wayland: WAYLAND_DISPLAY wird von der Session geerbt
# X11: DISPLAY=:0 als Fallback
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=graphical-session.target
