# OpenAI API Key for Whisper transcription (online mode)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Hugging Face Token (optional, for faster-whisper model downloads)
HF_TOKEN=hf_your-huggingface-token-here

# Path to config file (optional, default: ~/.config/transcriptor/config.json)
# BLITZTEXT_CONFIG=~/.config/transcriptor/config.json
